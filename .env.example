# --- Server ---
PORT=5000
NODE_ENV=development
# Origin của frontend, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173
# Gốc của link tin tìm người ở ghép (publicUrl = PUBLIC_WEB_URL/r/<slug>) và của mã QR trên poster.
# Quét QR bằng điện thoại thì `localhost` trỏ về chính điện thoại: đặt IP LAN của máy chạy frontend,
# ví dụ http://192.168.1.20:5173 (và thêm origin đó vào CORS_ORIGINS).
PUBLIC_WEB_URL=http://localhost:5173

# --- Database (docker-compose.yml, cổng 5433) ---
DATABASE_URL=postgresql://nestfair:nestfair@localhost:5433/nestfair?schema=public

# --- JWT (secret >= 64 ký tự, sinh bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---
JWT_SECRET=change-me
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- Google OAuth (để trống = tắt đăng nhập Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# --- Cloudinary (để trống = tắt upload ảnh minh chứng) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
