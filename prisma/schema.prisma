// NestFair — Prisma schema
// Issue #3: User, RefreshToken, House, HouseMember.
// Issue chores: Chore, ChoreAssignment.
// Issue #9: Expense, ExpenseSplit, Settlement.
// Issue #11: ReceiptScan (OCR hóa đơn), User.ocrConsentAt.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  /// Null khi tài khoản chỉ đăng nhập bằng Google.
  passwordHash String?
  googleId     String?   @unique
  fullName     String
  phone        String?
  /// Mã BIN 6 số của ngân hàng (Napas), dùng cho VietQR.
  bankBin      String?
  bankAccount  String?
  avatarUrl    String?
  /// Lúc người dùng đồng ý gửi ảnh hóa đơn tới Google Gemini. Null = chưa đồng ý (chặn quét OCR).
  ocrConsentAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens RefreshToken[]
  memberships   HouseMember[]
  absences      MemberAbsence[]

  expensesPaid        Expense[]      @relation("ExpensePayer")
  expensesCreated     Expense[]      @relation("ExpenseCreator")
  expenseSplits       ExpenseSplit[]
  settlementsSent     Settlement[]   @relation("SettlementFrom")
  settlementsReceived Settlement[]   @relation("SettlementTo")
  receiptScans        ReceiptScan[]

  @@map("users")
}

/// Mỗi phiên đăng nhập (thiết bị) một dòng. Chỉ lưu hash, xoay vòng mỗi lần refresh.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  /// "Ghi nhớ đăng nhập": true = cookie có hạn 7 ngày, false = cookie phiên (mất khi đóng trình duyệt).
  persistent Boolean   @default(true)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum HouseRole {
  /// Trưởng phòng: người tạo nhà.
  ADMIN
  ROOMMATE
}

model House {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  address         String?
  /// Số người tối đa (2–10). Đủ người thì không vào thêm được.
  maxMembers      Int
  /// 6 ký tự in hoa, bỏ ký tự dễ nhầm (0, O, 1, I). Không phân biệt hoa thường khi nhập.
  inviteCode      String   @unique
  inviteExpiresAt DateTime
  rules           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Ân hạn nộp muộn (giờ) sau dueAt; quá hạn + ân hạn thì cron đánh MISSED.
  choreGraceHours         Int @default(3)
  /// Số ca tối đa một người nhận trong một ngày (ràng buộc tốt nhất, xem H3).
  maxSlotsPerPersonPerDay Int @default(2)

  members       HouseMember[]
  chores        Chore[]
  assignments   ChoreAssignment[]
  weekSchedules WeekSchedule[]
  absences      MemberAbsence[]
  breaks        HouseBreak[]
  auditLogs     ChoreAuditLog[]
  expenses      Expense[]
  settlements   Settlement[]
  receiptScans  ReceiptScan[]

  @@map("houses")
}

/// Rời nhà thì đặt leftAt, không xóa dòng (giữ lịch sử chi tiêu, việc nhà).
/// Partial unique index (SQL tay trong migration): mỗi người tối đa 1 membership
/// còn hiệu lực (leftAt IS NULL) trong một nhà.
model HouseMember {
  id       String    @id @default(uuid()) @db.Uuid
  houseId  String    @db.Uuid
  userId   String    @db.Uuid
  role     HouseRole @default(ROOMMATE)
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignments         ChoreAssignment[] @relation("AssignmentAssignee")
  verifiedAssignments ChoreAssignment[] @relation("AssignmentVerifier")
  originalAssignments ChoreAssignment[] @relation("AssignmentOriginalAssignee")

  @@index([houseId])
  @@index([userId])
  @@map("house_members")
}

enum ChoreFrequency {
  DAILY
  WEEKLY
  /// Việc đột xuất (Lucky Wheel): không nằm trong lịch xoay.
  ADHOC
}

enum RotationMode {
  /// Một người sở hữu việc cả tuần (rào 3 tuần áp dụng).
  WEEK_BLOCK
  /// Mỗi lần một người, xoay vòng bằng khối hoán vị (giãn cách giữa các lần).
  PER_OCCURRENCE
}

enum ScheduleStatus {
  PUBLISHED
  LOCKED
  EMPTY
}

enum GeneratedBy {
  CRON
  CATCHUP
  USER
  ADMIN_REROLL
}

enum AssignmentSource {
  ROTATION
  SWAP
  COVER
  PAYBACK
  WHEEL
  REASSIGN
}

enum AssignmentStatus {
  TODO
  PENDING_VERIFY
  DONE
  REJECTED
  MISSED
  CANCELLED
  UNASSIGNED
}

enum VerifyMode {
  PEER
  AUTO_APPROVED
  SELF_ATTESTED
  ADMIN_OVERRIDE
}

/// Định nghĩa việc. Ràng buộc SQL tay trong migration: weight 1–5, recurrenceDays thuộc 1..7, dueTime HH:mm.
model Chore {
  id             String         @id @default(uuid()) @db.Uuid
  houseId        String         @db.Uuid
  title          String
  weight         Int
  frequency      ChoreFrequency @default(WEEKLY)
  /// ISO 1 = Thứ Hai … 7 = Chủ Nhật. DAILY = [1..7], ADHOC = [].
  recurrenceDays Int[]
  /// "HH:mm" giờ nhà (Asia/Ho_Chi_Minh).
  dueTime        String         @default("21:00")
  rotationMode   RotationMode   @default(WEEK_BLOCK)
  /// Chỉ PER_OCCURRENCE: cùng người không làm lại trong `occurrenceGap` lần kế tiếp.
  occurrenceGap  Int            @default(1)
  /// false = soft-delete, không xóa vật lý.
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  house       House             @relation(fields: [houseId], references: [id], onDelete: Cascade)
  assignments ChoreAssignment[]

  @@index([houseId])
  @@map("chores")
}

/// Một lịch / nhà / tuần. UNIQUE(houseId, weekStart) chống sinh trùng.
model WeekSchedule {
  id                String         @id @default(uuid()) @db.Uuid
  houseId           String         @db.Uuid
  /// Thứ Hai của tuần (giờ nhà).
  weekStart         DateTime       @db.Date
  weekKey           String
  status            ScheduleStatus
  generatedBy       GeneratedBy
  /// Seed RNG: tái lập được và minh bạch.
  seed              Int
  attempts          Int
  /// W_eff đã áp dụng (3/2/1).
  fenceWeeksApplied Int
  relaxLevel        Int            @default(0)
  relaxed           Boolean        @default(false)
  reasons           String[]
  rerollCount       Int            @default(0)
  loadSnapshot      Json
  algoVersion       String
  createdAt         DateTime       @default(now())

  house       House             @relation(fields: [houseId], references: [id], onDelete: Cascade)
  assignments ChoreAssignment[]

  @@unique([houseId, weekStart])
  @@map("week_schedules")
}

/// Một ca trực = một việc vào một ngày. Định danh (choreId, occurrenceDate, slotIndex).
model ChoreAssignment {
  id                 String           @id @default(uuid()) @db.Uuid
  houseId            String           @db.Uuid
  scheduleId         String?          @db.Uuid
  choreId            String           @db.Uuid
  /// HouseMember.id; null khi UNASSIGNED.
  assigneeId         String?          @db.Uuid
  /// Người được giao lúc xếp lịch; đổi ca sau này chỉ đổi assigneeId.
  originalAssigneeId String?          @db.Uuid
  weekKey            String
  weekStart          DateTime         @db.Date
  occurrenceDate     DateTime         @db.Date
  slotIndex          Int              @default(0)
  dueAt              DateTime
  /// Chụp lại để đổi tên / weight việc sau này không làm sai lịch sử.
  titleSnapshot      String
  weightSnapshot     Int
  source             AssignmentSource
  status             AssignmentStatus @default(TODO)
  proofImageUrl      String?
  /// SHA-256 ảnh minh chứng, chặn nộp lại ảnh cũ.
  proofHash          String?
  submittedAt        DateTime?
  isLate             Boolean          @default(false)
  rejectCount        Int              @default(0)
  /// HouseMember.id của người duyệt (khác assignee); null nếu duyệt tự động.
  verifiedById       String?          @db.Uuid
  verifiedAt         DateTime?
  verifyMode         VerifyMode?
  rejectReason       String?
  disputed           Boolean          @default(false)
  /// Idempotency-Key của lần check-in gần nhất.
  checkinKey         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  house            House         @relation(fields: [houseId], references: [id], onDelete: Cascade)
  schedule         WeekSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  chore            Chore         @relation(fields: [choreId], references: [id], onDelete: Cascade)
  assignee         HouseMember?  @relation("AssignmentAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  originalAssignee HouseMember?  @relation("AssignmentOriginalAssignee", fields: [originalAssigneeId], references: [id], onDelete: Restrict)
  verifiedBy       HouseMember?  @relation("AssignmentVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@unique([choreId, occurrenceDate, slotIndex])
  @@index([houseId, weekStart])
  @@index([houseId, proofHash])
  @@index([assigneeId, choreId, weekStart])
  @@index([status, dueAt])
  @@map("chore_assignments")
}

/// Thành viên vắng (gồm cả hai đầu). CHECK endDate >= startDate trong migration.
model MemberAbsence {
  id          String   @id @default(uuid()) @db.Uuid
  houseId     String   @db.Uuid
  userId      String   @db.Uuid
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  reason      String?
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([houseId, startDate, endDate])
  @@map("member_absences")
}

/// Cả nhà vắng (Tết, du lịch…): không sinh ca trong khoảng này.
model HouseBreak {
  id          String   @id @default(uuid()) @db.Uuid
  houseId     String   @db.Uuid
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  reason      String?
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@index([houseId, startDate, endDate])
  @@map("house_breaks")
}

/// Mọi thao tác override / re-roll / duyệt tự động / khai vắng.
model ChoreAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  houseId      String   @db.Uuid
  actorId      String?  @db.Uuid
  action       String
  assignmentId String?  @db.Uuid
  scheduleId   String?  @db.Uuid
  detail       Json
  createdAt    DateTime @default(now())

  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@index([houseId, createdAt])
  @@map("chore_audit_logs")
}

enum ExpenseCategory {
  FOOD
  RENT
  ELECTRICITY
  WATER
  INTERNET
  SUPPLIES
  /// Quà cảm ơn trực dùm (issue đổi ca).
  GIFT
  OTHER
}

enum SplitType {
  /// Chia đều cho cả nhà (thành viên còn ở lúc ghi khoản chi).
  EQUAL
  /// Chọn người hưởng, chia đều trong nhóm đó.
  CUSTOM
  /// Nhập số tiền từng người, tổng phải khớp.
  EXACT
  /// Theo từng món trên hóa đơn (OCR). Chưa cài ở issue #9.
  ITEMIZED
}

enum SettlementStatus {
  /// Người trả báo "đã chuyển", chờ chủ nợ xác nhận. Chưa tính vào số dư.
  PENDING
  CONFIRMED
  /// Người chuyển rút lại, hoặc chủ nợ báo chưa nhận được.
  CANCELLED
}

/// Tiền là số nguyên VNĐ. Ràng buộc SQL tay: totalAmount > 0.
/// Dùng userId (không dùng HouseMember.id) để số dư không đứt khi rời rồi vào lại nhà.
/// Σ ExpenseSplit.allocatedAmount = totalAmount do service kiểm tra trước khi lưu.
model Expense {
  id              String          @id @default(uuid()) @db.Uuid
  houseId         String          @db.Uuid
  payerId         String          @db.Uuid
  createdById     String          @db.Uuid
  title           String
  category        ExpenseCategory
  totalAmount     Int
  splitType       SplitType
  spentAt         DateTime
  note            String?
  receiptImageUrl String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  house       House          @relation(fields: [houseId], references: [id], onDelete: Cascade)
  payer       User           @relation("ExpensePayer", fields: [payerId], references: [id], onDelete: Restrict)
  createdBy   User           @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  splits      ExpenseSplit[]
  receiptScan ReceiptScan?

  @@index([houseId, spentAt])
  @@index([payerId])
  @@map("expenses")
}

/// Ràng buộc SQL tay: allocatedAmount >= 0.
model ExpenseSplit {
  id              String @id @default(uuid()) @db.Uuid
  expenseId       String @db.Uuid
  userId          String @db.Uuid
  allocatedAmount Int

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([expenseId, userId])
  @@index([userId])
  @@map("expense_splits")
}

/// Một lần chuyển tiền giữa hai thành viên. Chỉ CONFIRMED mới ảnh hưởng số dư.
/// SQL tay trong migration: amount > 0, fromUserId <> toUserId, confirmedAt chỉ có khi CONFIRMED,
/// partial unique index (houseId, fromUserId, toUserId) WHERE status = 'PENDING' (mỗi cặp một báo chờ xác nhận).
model Settlement {
  id          String           @id @default(uuid()) @db.Uuid
  houseId     String           @db.Uuid
  fromUserId  String           @db.Uuid
  toUserId    String           @db.Uuid
  amount      Int
  status      SettlementStatus @default(PENDING)
  /// Ảnh bill đính kèm khi báo đã chuyển.
  proofUrl    String?
  note        String?
  createdAt   DateTime         @default(now())
  confirmedAt DateTime?

  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)
  from  User  @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  to    User  @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: Restrict)

  @@index([houseId, status])
  @@index([houseId, createdAt])
  @@map("settlements")
}

enum ReceiptScanStatus {
  /// Có bản nháp để người dùng xác nhận.
  DRAFT
  /// Gemini lỗi / ảnh không đọc được: chuyển sang nhập tay.
  FAILED
  /// Đã gắn vào một khoản chi.
  USED
}

/// Một lần quét hóa đơn. Chỉ là bản nháp: không bao giờ tự tạo Expense (AI không tự ghi dữ liệu).
/// Mỗi dòng cũng là một lần gọi Gemini nên đếm hạn mức 20 lượt / nhà / ngày bằng cách đếm dòng theo ngày giờ VN.
model ReceiptScan {
  id            String            @id @default(uuid()) @db.Uuid
  houseId       String            @db.Uuid
  scannedById   String            @db.Uuid
  imageUrl      String
  status        ReceiptScanStatus
  /// NOT_A_RECEIPT | UNREADABLE | AI_TIMEOUT | AI_UNAVAILABLE khi status = FAILED.
  failureReason String?
  /// JSON nguyên bản Gemini trả về (debug và đánh giá độ chính xác OCR trong báo cáo).
  draftJson     Json?
  model         String?
  latencyMs     Int?
  /// Khoản chi được tạo từ bản nháp này (một-một).
  expenseId     String?           @unique @db.Uuid
  createdAt     DateTime          @default(now())

  house     House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  scannedBy User     @relation(fields: [scannedById], references: [id], onDelete: Restrict)
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([houseId, createdAt])
  @@map("receipt_scans")
}
