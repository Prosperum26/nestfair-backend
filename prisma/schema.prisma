// NestFair — Prisma schema
// Issue #3: User, RefreshToken, House, HouseMember.
// Issue chores: Chore, ChoreAssignment.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  /// Null khi tài khoản chỉ đăng nhập bằng Google.
  passwordHash String?
  googleId     String?  @unique
  fullName     String
  phone        String?
  /// Mã BIN 6 số của ngân hàng (Napas), dùng cho VietQR.
  bankBin      String?
  bankAccount  String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  memberships   HouseMember[]
  absences      MemberAbsence[]

  @@map("users")
}

/// Mỗi phiên đăng nhập (thiết bị) một dòng. Chỉ lưu hash, xoay vòng mỗi lần refresh.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  /// "Ghi nhớ đăng nhập": true = cookie có hạn 7 ngày, false = cookie phiên (mất khi đóng trình duyệt).
  persistent Boolean   @default(true)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum HouseRole {
  /// Trưởng phòng: người tạo nhà.
  ADMIN
  ROOMMATE
}

model House {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  address         String?
  /// Số người tối đa (2–10). Đủ người thì không vào thêm được.
  maxMembers      Int
  /// 6 ký tự in hoa, bỏ ký tự dễ nhầm (0, O, 1, I). Không phân biệt hoa thường khi nhập.
  inviteCode      String   @unique
  inviteExpiresAt DateTime
  rules           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Ân hạn nộp muộn (giờ) sau dueAt; quá hạn + ân hạn thì cron đánh MISSED.
  choreGraceHours         Int @default(3)
  /// Số ca tối đa một người nhận trong một ngày (ràng buộc tốt nhất, xem H3).
  maxSlotsPerPersonPerDay Int @default(2)

  members       HouseMember[]
  chores        Chore[]
  assignments   ChoreAssignment[]
  weekSchedules WeekSchedule[]
  absences      MemberAbsence[]
  breaks        HouseBreak[]
  auditLogs     ChoreAuditLog[]
  activities    HouseActivity[]
  wheelLogs     LuckyWheelLog[]

  @@map("houses")
}

/// Rời nhà thì đặt leftAt, không xóa dòng (giữ lịch sử chi tiêu, việc nhà).
/// Partial unique index (SQL tay trong migration): mỗi người tối đa 1 membership
/// còn hiệu lực (leftAt IS NULL) trong một nhà.
model HouseMember {
  id       String    @id @default(uuid()) @db.Uuid
  houseId  String    @db.Uuid
  userId   String    @db.Uuid
  role     HouseRole @default(ROOMMATE)
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignments         ChoreAssignment[] @relation("AssignmentAssignee")
  verifiedAssignments ChoreAssignment[] @relation("AssignmentVerifier")
  originalAssignments ChoreAssignment[] @relation("AssignmentOriginalAssignee")

  @@index([houseId])
  @@index([userId])
  @@map("house_members")
}

enum ChoreFrequency {
  DAILY
  WEEKLY
  /// Việc đột xuất (Lucky Wheel): không nằm trong lịch xoay.
  ADHOC
}

enum RotationMode {
  /// Một người sở hữu việc cả tuần (rào 3 tuần áp dụng).
  WEEK_BLOCK
  /// Mỗi lần một người, xoay vòng bằng khối hoán vị (giãn cách giữa các lần).
  PER_OCCURRENCE
}

enum ScheduleStatus {
  PUBLISHED
  LOCKED
  EMPTY
}

enum GeneratedBy {
  CRON
  CATCHUP
  USER
  ADMIN_REROLL
}

enum AssignmentSource {
  ROTATION
  SWAP
  COVER
  PAYBACK
  WHEEL
  REASSIGN
}

enum AssignmentStatus {
  TODO
  PENDING_VERIFY
  DONE
  REJECTED
  MISSED
  CANCELLED
  UNASSIGNED
}

enum VerifyMode {
  PEER
  AUTO_APPROVED
  SELF_ATTESTED
  ADMIN_OVERRIDE
}

/// Định nghĩa việc. Ràng buộc SQL tay trong migration: weight 1–5, recurrenceDays thuộc 1..7, dueTime HH:mm.
model Chore {
  id             String         @id @default(uuid()) @db.Uuid
  houseId        String         @db.Uuid
  title          String
  weight         Int
  frequency      ChoreFrequency @default(WEEKLY)
  /// ISO 1 = Thứ Hai … 7 = Chủ Nhật. DAILY = [1..7], ADHOC = [].
  recurrenceDays Int[]
  /// "HH:mm" giờ nhà (Asia/Ho_Chi_Minh).
  dueTime        String         @default("21:00")
  rotationMode   RotationMode   @default(WEEK_BLOCK)
  /// Chỉ PER_OCCURRENCE: cùng người không làm lại trong `occurrenceGap` lần kế tiếp.
  occurrenceGap  Int            @default(1)
  /// false = soft-delete, không xóa vật lý.
  isActive       Boolean        @default(true)
  /// Việc hệ thống, không hiện ở trang cài đặt, không vào lịch xoay. Hiện chỉ dùng cho "Việc đột xuất" của Lucky Wheel.
  isSystem       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  house       House             @relation(fields: [houseId], references: [id], onDelete: Cascade)
  assignments ChoreAssignment[]

  @@index([houseId])
  @@map("chores")
}

/// Một lịch / nhà / tuần. UNIQUE(houseId, weekStart) chống sinh trùng.
model WeekSchedule {
  id                String         @id @default(uuid()) @db.Uuid
  houseId           String         @db.Uuid
  /// Thứ Hai của tuần (giờ nhà).
  weekStart         DateTime       @db.Date
  weekKey           String
  status            ScheduleStatus
  generatedBy       GeneratedBy
  /// Seed RNG: tái lập được và minh bạch.
  seed              Int
  attempts          Int
  /// W_eff đã áp dụng (3/2/1).
  fenceWeeksApplied Int
  relaxLevel        Int            @default(0)
  relaxed           Boolean        @default(false)
  reasons           String[]
  rerollCount       Int            @default(0)
  loadSnapshot      Json
  algoVersion       String
  createdAt         DateTime       @default(now())

  house       House             @relation(fields: [houseId], references: [id], onDelete: Cascade)
  assignments ChoreAssignment[]

  @@unique([houseId, weekStart])
  @@map("week_schedules")
}

/// Một ca trực = một việc vào một ngày. Định danh (choreId, occurrenceDate, slotIndex).
model ChoreAssignment {
  id                 String           @id @default(uuid()) @db.Uuid
  houseId            String           @db.Uuid
  scheduleId         String?          @db.Uuid
  choreId            String           @db.Uuid
  /// HouseMember.id; null khi UNASSIGNED.
  assigneeId         String?          @db.Uuid
  /// Người được giao lúc xếp lịch; đổi ca sau này chỉ đổi assigneeId.
  originalAssigneeId String?          @db.Uuid
  weekKey            String
  weekStart          DateTime         @db.Date
  occurrenceDate     DateTime         @db.Date
  slotIndex          Int              @default(0)
  dueAt              DateTime
  /// Chụp lại để đổi tên / weight việc sau này không làm sai lịch sử.
  titleSnapshot      String
  weightSnapshot     Int
  source             AssignmentSource
  status             AssignmentStatus @default(TODO)
  proofImageUrl      String?
  /// SHA-256 ảnh minh chứng, chặn nộp lại ảnh cũ.
  proofHash          String?
  submittedAt        DateTime?
  isLate             Boolean          @default(false)
  rejectCount        Int              @default(0)
  /// HouseMember.id của người duyệt (khác assignee); null nếu duyệt tự động.
  verifiedById       String?          @db.Uuid
  verifiedAt         DateTime?
  verifyMode         VerifyMode?
  rejectReason       String?
  disputed           Boolean          @default(false)
  /// Idempotency-Key của lần check-in gần nhất.
  checkinKey         String?
  /// Khóa lạc quan, tăng khi đổi người hoặc đổi trạng thái (Issue #7).
  version            Int              @default(0)
  /// Yêu cầu đổi ca đã tạo ra `source` hiện tại, để truy vết (Issue #7).
  swapRequestId      String?          @db.Uuid
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  house            House         @relation(fields: [houseId], references: [id], onDelete: Cascade)
  schedule         WeekSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  chore            Chore         @relation(fields: [choreId], references: [id], onDelete: Cascade)
  assignee         HouseMember?  @relation("AssignmentAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  originalAssignee HouseMember?  @relation("AssignmentOriginalAssignee", fields: [originalAssigneeId], references: [id], onDelete: Restrict)
  verifiedBy       HouseMember?  @relation("AssignmentVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  /// Có khi ca sinh ra từ Lucky Wheel (source = WHEEL).
  wheelLog         LuckyWheelLog?

  @@unique([choreId, occurrenceDate, slotIndex])
  @@index([houseId, weekStart])
  @@index([houseId, proofHash])
  @@index([assigneeId, choreId, weekStart])
  @@index([status, dueAt])
  @@map("chore_assignments")
}

/// Thành viên vắng (gồm cả hai đầu). CHECK endDate >= startDate trong migration.
model MemberAbsence {
  id          String   @id @default(uuid()) @db.Uuid
  houseId     String   @db.Uuid
  userId      String   @db.Uuid
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  reason      String?
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([houseId, startDate, endDate])
  @@map("member_absences")
}

/// Cả nhà vắng (Tết, du lịch…): không sinh ca trong khoảng này.
model HouseBreak {
  id          String   @id @default(uuid()) @db.Uuid
  houseId     String   @db.Uuid
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  reason      String?
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@index([houseId, startDate, endDate])
  @@map("house_breaks")
}

/// Mọi thao tác override / re-roll / duyệt tự động / khai vắng.
model ChoreAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  houseId      String   @db.Uuid
  actorId      String?  @db.Uuid
  action       String
  assignmentId String?  @db.Uuid
  scheduleId   String?  @db.Uuid
  detail       Json
  createdAt    DateTime @default(now())

  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@index([houseId, createdAt])
  @@map("chore_audit_logs")
}

enum ActivityVisibility {
  HOUSE
  ADMIN_ONLY
}

/// Bảng tin hoạt động của nhà (Live Ticker). Ghi cùng transaction với nghiệp vụ, giữ 30 ngày.
model HouseActivity {
  id          String             @id @default(uuid()) @db.Uuid
  houseId     String             @db.Uuid
  /// 'chore.submitted', 'chore.verified', 'wheel.result', 'swap.accepted', ...
  type        String
  actorUserId String?            @db.Uuid
  /// Tên chụp lúc xảy ra (người đã rời nhà vẫn hiện đúng).
  actorName   String
  /// Tham số để client ghép câu: choreTitle, targetName, count, weekKey, participantNames...
  params      Json
  visibility  ActivityVisibility @default(HOUSE)
  /// Chống ghi hai lần cho cùng một sự kiện (retry, idempotency).
  dedupeKey   String?
  createdAt   DateTime           @default(now())

  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@unique([houseId, dedupeKey])
  @@index([houseId, createdAt])
  @@map("house_activities")
}

enum WheelStatus {
  SPINNING
  REVEALED
  VOIDED
}

/// Nhật ký Lucky Wheel. Lưu userId (không phải HouseMember.id); ca tạo ra lưu assigneeId = HouseMember.id như ca thường.
model LuckyWheelLog {
  id             String      @id @default(uuid()) @db.Uuid
  houseId        String      @db.Uuid
  spunById       String      @db.Uuid
  /// 3–60 ký tự, đã bỏ khoảng trắng thừa.
  taskTitle      String
  dueAt          DateTime
  /// Người tham gia do người quay chọn (userId), theo thứ tự hiển thị.
  participantIds String[]    @db.Uuid
  /// Số thành viên đủ điều kiện nhưng bị bỏ khỏi vòng (để ticker minh bạch).
  excludedCount  Int         @default(0)
  /// Thứ tự các lát trên vòng (userId, có lặp lại), đã xáo bằng seed.
  slices         String[]    @db.Uuid
  selectedUserId String      @db.Uuid
  assignmentId   String      @unique @db.Uuid
  /// Chỉ để xáo thứ tự lát và vẽ animation. KHÔNG quyết định người trúng.
  seed           Int
  landingIndex   Int
  status         WheelStatus @default(SPINNING)
  /// Lúc bánh xe bắt đầu quay (= startAt gửi cho client).
  spunAt         DateTime
  durationMs     Int         @default(6000)
  /// spunAt + durationMs
  revealAt       DateTime
  voidedById     String?     @db.Uuid
  voidReason     String?
  idempotencyKey String?
  createdAt      DateTime    @default(now())

  house      House           @relation(fields: [houseId], references: [id], onDelete: Cascade)
  assignment ChoreAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([houseId, spunById, idempotencyKey])
  @@index([houseId, spunAt])
  @@index([status, revealAt])
  @@map("lucky_wheel_logs")
}

enum SwapType {
  EXCHANGE
  COVER
  PERMANENT
}

enum SwapStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum Compensation {
  PAYBACK
  GIFT
}

enum DebtStatus {
  OPEN
  PAID
  FORGIVEN
  CANCELLED
}

enum SwapResolution {
  ACCEPTED_BY_TARGET
  REJECTED_BY_TARGET
  CANCELLED_BY_REQUESTER
  EXPIRED_NO_TAKER
  ESCALATED
  SLOT_CHANGED
  REQUESTER_DID_IT
  MEMBER_LEFT
  CHORE_DISABLED
  HOUSE_BREAK
  ADMIN_OVERRIDE
}

/// Yêu cầu đổi ca. Mọi tham chiếu người dùng HouseMember.id (D15). CHECK viết tay trong migration.
model ChoreSwapRequest {
  id                 String          @id @default(uuid()) @db.Uuid
  houseId            String          @db.Uuid
  type               SwapType
  /// HouseMember.id của người gửi (cùng quy ước với ChoreAssignment.assigneeId)
  requesterMemberId  String          @db.Uuid
  /// HouseMember.id của người nhận đích danh. null = Chợ ca (chỉ COVER)
  targetMemberId     String?         @db.Uuid
  fromAssignmentId   String?         @db.Uuid
  toAssignmentId     String?         @db.Uuid
  compensation       Compensation?
  /// Ghi chú quà, tối đa 100 ký tự. Hiện được trên Chợ ca.
  rewardNote         String?         @db.VarChar(100)
  /// VNĐ, nguyên. Chỉ khi compensation = GIFT.
  rewardAmount       Int?
  /// Lý do riêng tư. Chỉ người gửi, người nhận và Admin thấy (D5). Không lên ticker.
  reason             String?         @db.VarChar(200)
  /// Lời nhắn gửi người nhận đích danh. Không hiện trên Chợ ca (D5).
  note               String?         @db.VarChar(200)
  status             SwapStatus      @default(PENDING)
  resolution         SwapResolution?
  expiresAt          DateTime
  acceptedById       String?         @db.Uuid
  acceptedAt         DateTime?
  /// Idempotency-Key của lần accept thành công, để trả lại kết quả cũ khi bấm lại
  acceptIdemKey      String?
  /// Chuỗi leo thang: id của yêu cầu đầu tiên cùng một ca
  rootRequestId      String          @db.Uuid
  /// ADD_REWARD | RESEND | SELF | SELF_DEFAULT
  escalationChoice   String?
  /// = dueAt của ca − 1 giờ. Sau mốc này, mặc định SELF_DEFAULT
  escalationDeadline DateTime?
  /// Snapshot để tính tải và nợ, không đổi khi weight của việc đổi sau này
  fromWeightSnapshot Int
  toWeightSnapshot   Int?
  /// Nợ cũ đã được cấn trừ bởi yêu cầu này (R-SWAP-7)
  offsetDebtId       String?         @db.Uuid
  version            Int             @default(0)
  createdAt          DateTime        @default(now())

  @@index([houseId, status, expiresAt])
  @@index([rootRequestId])
  @@map("chore_swap_requests")
}

/// Khóa một ca đang nằm trong yêu cầu PENDING (ở vai trò gửi hoặc đích).
model SwapLock {
  /// PK: một ca chỉ thuộc tối đa một yêu cầu PENDING (R-SWAP-1)
  assignmentId  String @id @db.Uuid
  swapRequestId String @db.Uuid

  @@map("swap_locks")
}

/// Sổ nợ ca (làm bù). CHECK weight >= 1 trong migration.
model ChoreDebt {
  id                  String     @id @default(uuid()) @db.Uuid
  houseId             String     @db.Uuid
  /// HouseMember.id: người được làm hộ, đang nợ ca
  debtorMemberId      String     @db.Uuid
  /// HouseMember.id: người đã làm hộ, được làm bù
  creditorMemberId    String     @db.Uuid
  swapRequestId       String     @db.Uuid
  /// Ca gốc được làm hộ. Nợ chỉ có hiệu lực khi ca này DONE (D7)
  coverAssignmentId   String     @db.Uuid
  /// fromWeightSnapshot của ca gốc, hoặc phần chênh sau cấn trừ. >= 1
  weight              Int
  status              DebtStatus @default(OPEN)
  /// OFFSET | DEBTOR_LEFT | CREDITOR_LEFT | COVER_MISSED | ADMIN_REASSIGN | ABSENT_REASSIGN | STALE | FORGIVEN_BY_CREDITOR
  closeReason         String?
  pickOpensAt         DateTime?
  pickDeadlineAt      DateTime?
  pickAttempts        Int        @default(0)
  paybackAssignmentId String?    @db.Uuid
  createdAt           DateTime   @default(now())
  settledAt           DateTime?

  @@index([debtorMemberId, status])
  @@index([creditorMemberId, status])
  @@map("chore_debts")
}

/// Chỉ cho PERMANENT. Could, cắt đầu tiên nếu trễ.
model RotationSwap {
  id                 String   @id @default(uuid()) @db.Uuid
  houseId            String   @db.Uuid
  swapRequestId      String   @db.Uuid
  userAMemberId      String   @db.Uuid
  userBMemberId      String   @db.Uuid
  effectiveWeekStart DateTime @db.Date
  /// WAITING | APPLIED | FAILED | CANCELLED
  status             String
  failReason         String?

  @@map("rotation_swaps")
}
